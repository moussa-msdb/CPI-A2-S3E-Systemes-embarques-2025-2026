VARIABLES GLOBALES:
    Mode_Actuel = STANDARD
    Mode_Precedent = STANDARD

FONCTION changement_de_mode()
    // 1. Appui long sur le Bouton Rouge (5 secondes)
    SI Appui_Long(Bouton_Rouge, 5s) ALORS
        SI Mode_Actuel == STANDARD OU Mode_Actuel == ECONOMIQUE ALORS
            Mode_Precedent = Mode_Actuel
            Mode_Actuel = MAINTENANCE
        SINON SI Mode_Actuel == ECONOMIQUE ALORS
            // Retour au standard depuis l'éco
            Mode_Actuel = STANDARD
        SINON SI Mode_Actuel == MAINTENANCE ALORS
            // Sortie de maintenance, retour d'où on vient
            Mode_Actuel = Mode_Precedent
        FIN SI
    FIN SI

    // 2. Appui long sur le Bouton Vert (5 secondes)
    SI Appui_Long(Bouton_Vert, 5s) ALORS
        SI Mode_Actuel == STANDARD ALORS
            Mode_Actuel = ECONOMIQUE
        FIN SI
    FIN SI

    // 3. Timeout d'inactivité en mode Configuration (30 min)
    SI Mode_Actuel == CONFIGURATION ALORS
        SI Temps_Sans_Saisie_Serie > 30_MINUTES ALORS
            Mode_Actuel = STANDARD
        FIN SI
    FIN SI
FIN FONCTION
